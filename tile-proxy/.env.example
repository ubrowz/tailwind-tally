# Copy to .env for local testing (never commit the real .env file).
# On Render, set these as real environment variables in the dashboard instead.

MAPTILER_KEY=your_maptiler_key_here

# Restrict which page origin may call this proxy from a browser.
# Use * while testing locally; tighten to your real site once deployed,
# e.g. https://yourusername.github.io
ALLOWED_ORIGIN=*
